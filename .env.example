# Supabase — sao chép file này thành .env và điền giá trị của ĐÚNG project
# Attendance Management mới (không dùng project cũ, không dùng service_role key).
# Không commit file .env chứa khóa bí mật lên Git (.gitignore đã chặn).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
